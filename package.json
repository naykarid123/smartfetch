{
  "name": "@naykarid123/smartfetch",
  "version": "1.0.0",
  "description": "Wrapper avanzado sobre fetch: timeouts, reintentos automáticos, interceptores y aspectos. Cero dependencias.",
  "keywords": [
    "fetch",
    "http",
    "client",
    "axios-alternative",
    "retry",
    "timeout",
    "typescript",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Naykarid y Maria",
  "contributors": [
    "Naykarid (https://github.com/naykarid123)",
    "Maria (https://github.com/mvfuentes.24)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naykarid123/smartfetch.git"
  },
  "bugs": {
    "url": "https://github.com/naykarid123/smartfetch/issues"
  },
  "homepage": "https://github.com/naykarid123/smartfetch#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:coverage": "jest --coverage",
    "example": "ts-node example.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
